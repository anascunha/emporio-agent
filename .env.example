# LLM provider: "anthropic" (default) or "ollama"
LLM_PROVIDER=anthropic

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Reasoning effort: low (default, fast chat) | medium | high
ANTHROPIC_EFFORT=low

# Ollama (local) — the model must support tool calling
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Reference date used as "today" (YYYY-MM-DD). See README > Assumptions.
EMPORIO_TODAY=2026-03-23
